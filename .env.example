# DATABASE_URL: Postgres connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
# Copy this file to .env.local for local development (never commit the real file).
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# PORT: Port the Express server listens on. Defaults to 3000 if unset.
PORT=3000

# NODE_ENV: Set to "production" on the deployed server so the app serves the
# built static bundle from dist/ instead of running the Vite dev middleware.
NODE_ENV=development

# JWT_SECRET: Signs member-portal login tokens. Use a long random string in
# production (e.g. `openssl rand -hex 32`) — never reuse the example value.
JWT_SECRET=replace-with-a-long-random-secret

# PAYSTACK_SECRET_KEY: Server-side only. Used to initialize/verify payments
# and to check webhook signatures. Get this from your Paystack dashboard
# (Settings -> API Keys & Webhooks). Never expose this to the frontend.
PAYSTACK_SECRET_KEY=sk_test_replace_with_real_key

# PAYSTACK_PUBLIC_KEY: Safe to expose to the browser — used to open the
# Paystack Inline checkout popup.
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_real_key

# DUES_CURRENCY: ISO currency code Paystack should charge in for both
# welfare dues and event payments (e.g. GHS, NGN, ZAR, USD — must be a
# currency enabled on your Paystack account).
DUES_CURRENCY=GHS

# PAYSTACK_MOCK: When PAYSTACK_SECRET_KEY/PAYSTACK_PUBLIC_KEY above aren't
# set, the app automatically simulates the whole Paystack flow (a fake
# checkout popup, instant "success", no real API calls, no real keys
# needed) so you can test the member portal's payment features immediately.
# Leave this unset to get that automatic behavior.
#   PAYSTACK_MOCK=true  forces the simulation on even if real keys ARE set
#                        (useful for a staging box that should never move
#                        real money).
#   PAYSTACK_MOCK=false forces it off — if real keys are missing, payments
#                        correctly show "not configured" instead of quietly
#                        mocking in what looks like a live environment.
# PAYSTACK_MOCK=true

# UPLOADS_DIR: Where the CMS's Legacy Gallery bulk-upload feature (Staff
# Login -> Legacy Gallery -> drag & drop photos/videos) writes uploaded
# files on disk. Defaults to a local "uploads" folder inside the app's
# working directory, served at /uploads/... — fine for local dev.
#
# On the VM, consider pointing this OUTSIDE your deployed app directory
# (e.g. a sibling folder like /home/edwinaikins/apps/de-elites-family-uploads)
# so uploaded event photos/videos are never at risk of being wiped by a
# future clean checkout/redeploy. See DEPLOYMENT.md for the recommended
# production value.
# UPLOADS_DIR=/home/edwinaikins/apps/de-elites-family-uploads

# --- Transactional email (welcome emails when an admin creates a member
# account, and when an admin resets a member's password) ---

# SITE_URL: The public URL used inside those emails for the "Log In To Your
# Portal" link. Defaults to https://de-elitesfamily.org if unset.
# SITE_URL=https://de-elitesfamily.org

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: Credentials for the SMTP
# server that sends these emails (e.g. from Gmail, Zoho Mail, SendGrid,
# Mailgun, Amazon SES — any provider that gives you SMTP credentials works).
# SMTP_PORT defaults to 587 if unset; set it to 465 for implicit TLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=replace-with-real-smtp-password

# SMTP_FROM: The "From" address/name emails are sent as. Defaults to
# "DE ELITES FAMILY <no-reply@de-elitesfamily.org>" if unset — most SMTP
# providers require this to be a domain/address you've verified with them.
# SMTP_FROM="DE ELITES FAMILY <no-reply@de-elitesfamily.org>"

# MAIL_MOCK: When the SMTP_* variables above aren't set, the app
# automatically "sends" these emails by just logging the username/temporary
# password to the server console instead — so account creation still works
# immediately without needing real SMTP credentials. Leave this unset to get
# that automatic behavior.
#   MAIL_MOCK=true  forces the simulation on even if real SMTP_* values ARE
#                    set (useful for a staging box that shouldn't send real
#                    email to real people).
#   MAIL_MOCK=false forces it off — if SMTP_* is missing, member creation
#                    still succeeds but the app reports the email failed to
#                    send, so you know to share credentials manually.
# MAIL_MOCK=true
